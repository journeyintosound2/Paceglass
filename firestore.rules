rules_version = '2';

// Paceglass security rules. Paste these into Firebase console → Firestore Database → Rules.
//
// Who can do what:
// - admins/{uid}     Created by hand in the console. Each admin can read only their own entry.
// - members/{email}  People allowed to use Paceglass. Admins manage them. A person can read their own entry.
// - userData/{uid}   A person's drink log. Only that person can read or write it, and only while they
//                    are an active member (or an admin). Admins cannot read anyone else's log.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isActiveMember() {
      return signedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/members/$(myEmail()))
        && get(/databases/$(database)/documents/members/$(myEmail())).data.status == 'active';
    }

    function validMember() {
      let d = request.resource.data;
      return d.keys().hasOnly(['email', 'name', 'note', 'status', 'createdAt', 'updatedAt', 'createdBy'])
        && d.status in ['active', 'disabled']
        && d.email is string
        && (!('name' in d) || (d.name is string && d.name.size() <= 80))
        && (!('note' in d) || (d.note is string && d.note.size() <= 200));
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /members/{email} {
      allow read: if isAdmin() || (signedIn() && request.auth.token.email != null && myEmail() == email);
      allow create, update: if isAdmin() && validMember() && request.resource.data.email == email;
      allow delete: if isAdmin();
    }

    match /userData/{uid} {
      allow read, write: if signedIn()
        && request.auth.uid == uid
        && (isActiveMember() || isAdmin());
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
